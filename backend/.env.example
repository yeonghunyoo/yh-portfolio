# @yh/backend — views API. Copy to .env and fill in. NEVER commit the filled file.
# Upstash Redis (Vercel Marketplace integration). Both are required in production;
# when neither these nor the fallbacks below resolve, every route answers
# 503 store_unavailable, by contract.
#
# On Vercel you can leave both blank: attaching the Upstash database to the project
# injects KV_REST_API_URL / KV_REST_API_TOKEN (and UPSTASH_REDIS_REST_URL /
# UPSTASH_REDIS_REST_TOKEN), which the store reads when the two names below are unset.
# Set these only to point at a different database than the attached one.

# Upstash Redis REST endpoint, e.g. https://your-db-name.upstash.io
VIEWS_STORE_URL=

# Upstash Redis REST token (bearer). Read+write. Rotate from the Upstash console.
VIEWS_STORE_TOKEN=

# Optional, local dev only. Set to "memory" to run the routes with in-process
# counters and no Upstash credentials. Leave unset in every deployed environment.
# VIEWS_STORE_DRIVER=memory

# Optional, local dev server only (src/server.ts). Defaults to 4321.
# PORT=4321
