  "css_state_rules": [
    {
      "selector": "a:hover",
      "style": {
        "text-decoration": "underline"
      }
    },
    {
      "selector": "[data-cur=\"1\"]",
      "style": {
        "color": "DesignTokens.accent!important",
        "font-weight": "600"
      }
    },
    {
      "selector": "[data-cur=\"1\"] span",
      "style": {
        "color": "DesignTokens.accent!important"
      }
    },
    {
      "selector": "[data-tok=\"1\"]",
      "style": {
        "background": "DesignTokens.hl",
        "box-shadow": "0 0 0 1px DesignTokens.accent",
        "border-bottom-color": "transparent"
      }
    },
    {
      "selector": "tbody tr:hover td",
      "style": {
        "background": "DesignTokens.hl",
        "box-shadow": "inset 0 1px 0 DesignTokens.accent,inset 0 -1px 0 DesignTokens.accent"
      }
    },
    {
      "selector": "tbody tr:hover td:first-child",
      "style": {
        "box-shadow": "inset 1px 0 0 DesignTokens.accent,inset 0 1px 0 DesignTokens.accent,inset 0 -1px 0 DesignTokens.accent"
      }
    },
    {
      "selector": "tbody tr:hover td:last-child",
      "style": {
        "box-shadow": "inset -1px 0 0 DesignTokens.accent,inset 0 1px 0 DesignTokens.accent,inset 0 -1px 0 DesignTokens.accent"
      }
    }
  ],
  "page": {
    "scroll_behavior": "smooth",
    "transitions": [
      {
        "selector": "body",
        "value": "background .3s,color .3s"
      },
      {
        "selector": "[data-tok]",
        "value": "background .15s"
      },
      {
        "selector": "tbody tr",
        "value": "background .15s"
      }
    ]
  },
  "window_listeners": [
    "window:keydown",
    "window:scroll"
  ]
