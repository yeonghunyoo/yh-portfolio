---
import type { CodeSample } from "../lib/codeBlocks";

interface Props {
  sample: CodeSample;
}

const { sample } = Astro.props;
---

<div class="card">
  <div class="title">{sample.title}</div>
  <pre data-tok-leave tabindex="0">{sample.parts.map((part) => (part.tok ? <span data-tok="0" data-tok-key={part.tok}>{part.text}</span> : part.text))}</pre>
</div>

<style>
  .card {
    background: var(--code-bg);
    color: var(--code-ink);
    border-radius: 10px;
    padding: 14px 16px;
    min-width: 0;
  }

  .title {
    font: 600 12.5px var(--font-mono);
    color: var(--accent);
    margin-bottom: 10px;
  }
</style>
