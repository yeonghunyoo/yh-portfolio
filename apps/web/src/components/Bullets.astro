---
/**
 * A career achievement rendered as a list rather than one comma-joined run.
 * The optional `intro` stays above the bullets — the Let's Bee 클락 entry names a
 * count ("트러블슈팅 6건") that the six items underneath then spell out.
 */
import type { RevisedList } from "../content/revisedCopy";

interface Props {
  list: RevisedList;
}

const { list } = Astro.props;
---

{list.intro && <div class="intro">{list.intro}</div>}
<ul class="bullets">
  {list.items.map((item) => <li>{item}</li>)}
</ul>

<style>
  .intro{color:var(--muted);margin-top:2px}
  .bullets{
    list-style:none;margin:4px 0 0;padding:0;
    color:var(--muted);display:flex;flex-direction:column;gap:3px;
  }
  .bullets li{position:relative;padding-left:12px}
  /* Drawn rather than a list marker so the bullet sits on the first line's
     optical centre whatever the line height, and never shifts when text wraps. */
  .bullets li::before{
    content:"";position:absolute;left:0;top:.62em;
    width:3px;height:3px;border-radius:50%;background:var(--muted);
  }
</style>
