---
/**
 * Header + fixed footer shared by the loading, 404 and 500 views of the design export
 * the human added after the contract was frozen. The three contracted screens keep
 * their own headers, so this chrome exists only for the system pages.
 */
import { Screens, ScreenPaths } from "@generated/Screens";
import { Strings } from "@generated/Strings";
import { RawCopy } from "../content/rawCopy";
import { ContactCopy } from "../content/systemCopy";
---

<header class="chrome-header">
  <div class="bar">
    <a class="wordmark" href={ScreenPaths[Screens.resume]}>{Strings.Resume.yuyeonghun}</a>
    <button class="theme" type="button" data-on-click="toggleTheme" title={RawCopy.title1}>
      <span class="dot"></span><span data-theme-label>{RawCopy.themeLight}</span>
    </button>
  </div>
</header>

<slot />

<footer class="chrome-footer">
  <div class="bar">
    <span>{Strings.Resume.yuyeonghun} · {Strings.Resume.softwareEngineerIosBuilder}</span>
    <span>{ContactCopy.email} · {ContactCopy.github}</span>
  </div>
</footer>

<style>
  .chrome-header{border-bottom:1px solid var(--line)}
  .chrome-footer{border-top:1px solid var(--line);position:fixed;left:0;right:0;bottom:0;background:var(--bg);z-index:10}
  .bar{max-width:1080px;margin:0 auto;padding:14px 32px;display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap}
  .chrome-footer .bar{font:12px 'IBM Plex Mono',monospace;color:var(--muted)}
  .wordmark{font-weight:700;font-size:16px;color:var(--ink);text-decoration:none}
  .theme{display:flex;align-items:center;gap:6px;border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:999px;padding:5px 12px 5px 8px;font:500 12px 'IBM Plex Mono',monospace;cursor:pointer}
  .theme:hover{border-color:var(--accent)}
  .dot{width:14px;height:14px;border-radius:50%;background:var(--accent);display:inline-block}

  @media (max-width:820px){
    .bar{padding:12px 20px}
    .chrome-footer .bar{font-size:11px;gap:4px}
  }
</style>
