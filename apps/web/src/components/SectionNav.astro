---
import { SECTION_LINKS } from "../lib/screens";
---

<aside class="rail">
  <div class="sticky">
    {/* `scrollRail` — document progress, scaled by the scroll listener. */}
    <div class="progress" data-scroll-rail aria-hidden="true"></div>

    {/* `navScrollSpy` — the last section past the 140px line is marked current. */}
    <nav class="nav">
      {
        SECTION_LINKS.map((section) => (
          <a class="link" href={section.href} data-section-link={section.id} data-cur="0">
            {section.ordinal}
            <br />
            <span>{section.label}</span>
          </a>
        ))
      }
    </nav>
  </div>
</aside>

<script>
  import { initScrollSpy } from "../lib/scrollSpy";

  initScrollSpy();
</script>

<style>
  .rail {
    position: relative;
  }

  .sticky {
    position: sticky;
    top: 96px;
    padding: 56px 0 0 20px;
    font: 12.5px/1.35 var(--font-mono);
  }

  .progress {
    position: absolute;
    left: -1px;
    top: 56px;
    bottom: 0;
    width: 2px;
    background: var(--accent);
    transform-origin: top;
    transform: scaleY(0);
    transition: transform 0.15s linear;
  }

  .nav {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .link {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .link:hover {
    color: var(--ink);
    text-decoration: none;
  }

  .link span {
    color: var(--ink);
  }
</style>
