---
/**
 * The terminal that greets a first visit to the landing page — the loading view of the
 * design export the human added after the contract was frozen.
 *
 * It covers the page rather than replacing it: the resume is in the DOM the whole time,
 * so a crawler, a reader with JavaScript off and anyone arriving a second time all get
 * the content immediately. An inline script removes the overlay before the first paint
 * when this session has already seen it, so a repeat visit never flashes.
 */
import { LoadingCopy } from "../content/systemCopy";
import { SEEN_KEY, SEEN_FRESH_FOR_MS } from "../lib/loadingTerminal";
---

<div class="overlay" data-loading-terminal aria-hidden="true">
  <div class="window">
    <div class="titlebar">
      <span class="light red"></span><span class="light amber"></span><span class="light green"></span>
      <span class="title">{LoadingCopy.windowTitle}</span>
    </div>
    <div class="body"><span data-terminal-text></span><span class="cursor"></span></div>
  </div>
</div>

{/*
  Before the first paint: drop the overlay outright if this tab saw it a moment ago.
  Closing the tab clears sessionStorage, so coming back shows it again — except that
  a browser restoring a session (reopen-closed-tab, "continue where you left off")
  hands the flag back and the visit looks like a reload. The timestamp settles that:
  a restored flag is old, so the terminal plays again.
*/}
<script is:inline define:vars={{ seenKey: SEEN_KEY, freshForMs: SEEN_FRESH_FOR_MS }}>
  try {
    var seenAt = Number(window.sessionStorage.getItem(seenKey));
    if (seenAt > 0 && Date.now() - seenAt < freshForMs) {
      var node = document.querySelector("[data-loading-terminal]");
      if (node) node.remove();
    }
  } catch (error) {
    /* storage disabled — the terminal simply shows again */
  }
</script>

<style is:global>
  /*
   * 오버레이가 떠 있는 동안 뒤 페이지가 스크롤되면, 사라진 뒤 문서 중간에서
   * 읽기 시작하게 된다. :has() 로 잠그면 노드가 제거되는 순간 저절로 풀리므로
   * 따로 되돌릴 상태가 없다 — 첫 페인트 전에 제거되는 재방문 경로에서도 안전하다.
   */
  html:has([data-loading-terminal]) { overflow: hidden; }
</style>

<style>
  .overlay{
    position:fixed;inset:0;z-index:60;background:var(--bg);
    overscroll-behavior:contain;touch-action:none;
    display:flex;align-items:center;justify-content:center;padding:32px;
    animation:rise .3s ease both;
  }
  .overlay[data-leaving]{opacity:0;transition:opacity .35s ease;pointer-events:none}

  .window{
    background:var(--code-bg);color:var(--code-ink);border-radius:12px;
    border:1px solid var(--line-soft);width:100%;max-width:820px;overflow:hidden;
  }
  .titlebar{
    display:flex;align-items:center;gap:8px;padding:10px 14px;
    border-bottom:1px solid var(--line-soft);background:var(--surface);
  }
  .light{width:11px;height:11px;border-radius:50%;display:inline-block}
  /* The three traffic lights are macOS chrome, not palette — they stay literal. */
  .red{background:#FF5F57}
  .amber{background:#FEBC2E}
  .green{background:#28C840}
  .title{margin-left:auto;margin-right:auto;font:12px 'IBM Plex Mono',monospace;color:var(--code-dim)}

  .body{
    padding:16px 18px 18px;font:14.5px/1.8 'IBM Plex Mono',monospace;
    min-height:120px;white-space:pre-wrap;word-break:break-word;
  }
  .cursor{
    display:inline-block;width:9px;height:16px;vertical-align:-2px;
    background:var(--accent);animation:blink 1s step-end infinite;
  }

  @keyframes blink{50%{opacity:0}}

  @media (max-width:820px){
    .overlay{padding:16px}
    /* Bigger than it was (12.5px), and bigger than the desktop size — a phone held at
       arm's length needs it more than a monitor does. The opening command is 52
       characters so it still takes two rows here; that is what a terminal does. */
    .body{font-size:15px;line-height:1.9;min-height:120px;padding:14px}
    .title{font-size:11px}
  }

  /* Someone who asked for less motion gets the finished frame, not the typing. */
  @media (prefers-reduced-motion:reduce){
    .overlay,.cursor{animation:none}
    .overlay[data-leaving]{transition:none}
  }
</style>
