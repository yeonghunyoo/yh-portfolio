.a4{background:var(--ink);color:var(--bg);padding:10px 18px;border-radius:8px;font-size:14px;font-weight:600;text-decoration:none}
.a4:hover{background:var(--accent);color:var(--accent-ink)}
.aside1{position:relative}
.div34{position:sticky;top:96px;padding:56px 0 0 20px;font:12.5px/1.35 'IBM Plex Mono',monospace}
.div35{position:absolute;left:-1px;top:56px;bottom:0;width:2px;background:var(--accent);transform-origin:top;transform:scaleY(var(--rail-scale,0));transition:transform .15s linear}
