.div16{position:absolute;left:0;right:0;bottom:0;background:var(--accent);height:var(--m5,45%);transition:height .6s .2s cubic-bezier(.2,.7,.2,1)}
.div17{display:flex;justify-content:space-between;font:10.5px 'IBM Plex Mono',monospace;color:var(--muted);margin-top:4px}
