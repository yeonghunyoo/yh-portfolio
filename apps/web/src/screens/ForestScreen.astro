.div11{flex:1;background:var(--surface);border-radius:3px;height:100%;position:relative;overflow:hidden}
.div12{position:absolute;left:0;right:0;bottom:0;background:var(--accent);height:var(--m1,55%);transition:height .6s cubic-bezier(.2,.7,.2,1)}
.div13{position:absolute;left:0;right:0;bottom:0;background:var(--accent);height:var(--m2,30%);transition:height .6s .05s cubic-bezier(.2,.7,.2,1)}
