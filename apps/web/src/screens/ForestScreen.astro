<Lightbox />

<style>
[data-cur="1"]{color:var(--accent)!important;font-weight:600}
[data-cur="1"] span{color:var(--accent)!important}
[data-pair="1"]{background:var(--hl);border-radius:6px}
.header1{position:sticky;top:0;z-index:20;background:var(--bg);border-bottom:1px solid var(--line)}
.div1{max-width:1180px;margin:0 auto;padding:14px 32px;display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap}
.a1{font-weight:700;font-size:16px;color:var(--ink);text-decoration:none}
.a1:hover{color:var(--accent)}
.div2{display:flex;gap:6px}
.a2{border:1px solid var(--line);color:var(--ink);border-radius:8px;padding:6px 14px;font-size:13px;font-weight:500;text-decoration:none}
.a2:hover{border-color:var(--accent);color:var(--accent)}
.span1{background:var(--ink);color:var(--bg);border:1px solid var(--ink);border-radius:8px;padding:6px 14px;font-size:13px;font-weight:600}
.div3{display:flex;align-items:center;gap:10px}
.span2{font:13px 'IBM Plex Mono',monospace;color:var(--muted)}
.button1{display:flex;align-items:center;gap:6px;border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:999px;padding:5px 12px 5px 8px;font:500 12px 'IBM Plex Mono',monospace;cursor:pointer}
.button1:hover{border-color:var(--accent)}
.span3{width:14px;height:14px;border-radius:50%;background:var(--accent);display:inline-block}
.div4{max-width:1180px;margin:0 auto;padding:0 32px;display:grid;grid-template-columns:minmax(0,1fr) 150px;gap:0}
.main1{min-width:0;padding-right:36px;border-right:1px solid var(--line-soft)}
.section1{padding:56px 0 0;scroll-margin-top:90px;animation:rise .5s ease both}
.h11{margin:10px 0 0;font-size:34px;line-height:1.3;font-weight:700;letter-spacing:-.01em;text-wrap:pretty}
.p1{margin:16px 0 0;font-size:17px;line-height:1.75;color:var(--muted);max-width:720px;text-wrap:pretty}
.a3{font-weight:600}
.div5{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:16px;margin-top:32px}
.figure1{margin:0}
/* height:auto is load-bearing — <Image> emits width/height attributes (1320x2868 here),
   and without it the attribute height wins over the intrinsic ratio and stretches the
   shot to 2868px tall. The prototype's plain <img> carried no attributes, so it never
   needed this. */
.img1{width:100%;height:auto;border-radius:22px;border:1px solid var(--line);display:block;cursor:zoom-in;transition:transform .3s}
.img1:hover{transform:translateY(-6px)}
.figcaption1{font:12px 'IBM Plex Mono',monospace;color:var(--muted);margin-top:8px;text-align:center}
.section2{padding:56px 0 0;scroll-margin-top:90px}
.div6{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:36px}
.h21{margin:0;font-size:24px;font-weight:700}
.div7{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px;margin-top:14px;font-size:15.5px;line-height:1.6}
.div8{border:1px solid var(--line);border-radius:10px;padding:14px 16px;background:var(--card);transition:border-color .2s}
.div8:hover{border-color:var(--accent)}
.div9{color:var(--muted)}
.div10{display:flex;gap:8px;align-items:flex-end;height:38px;margin-top:10px}
.div11{flex:1;background:var(--surface);border-radius:3px;height:100%;position:relative;overflow:hidden}
.div12{position:absolute;left:0;right:0;bottom:0;background:var(--accent);height:var(--m1,55%);transition:height .6s cubic-bezier(.2,.7,.2,1)}
.div13{position:absolute;left:0;right:0;bottom:0;background:var(--accent);height:var(--m2,30%);transition:height .6s .05s cubic-bezier(.2,.7,.2,1)}
.div14{position:absolute;left:0;right:0;bottom:0;background:var(--accent);height:var(--m3,70%);transition:height .6s .1s cubic-bezier(.2,.7,.2,1)}
.div15{position:absolute;left:0;right:0;bottom:0;background:var(--accent);height:var(--m4,20%);transition:height .6s .15s cubic-bezier(.2,.7,.2,1)}
.div16{position:absolute;left:0;right:0;bottom:0;background:var(--accent);height:var(--m5,45%);transition:height .6s .2s cubic-bezier(.2,.7,.2,1)}
.div17{display:flex;justify-content:space-between;font:10.5px 'IBM Plex Mono',monospace;color:var(--muted);margin-top:4px}
.div18{border:1px solid var(--line);border-radius:10px;padding:14px 16px;background:var(--card)}
.div19{border:1px dashed var(--line);border-radius:10px;padding:14px 16px;color:var(--muted)}
.b1{color:var(--ink)}
.div20{font:11px 'IBM Plex Mono',monospace;margin-top:2px}
.div21{display:flex;flex-wrap:wrap;gap:6px;margin-top:14px}
.span4{border:1px solid var(--line);border-radius:999px;padding:4px 12px;font:12.5px 'IBM Plex Mono',monospace}
.div22{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:10px;margin-top:14px;font-size:15.5px;line-height:1.65}
.div23{border:1px solid var(--line);border-radius:10px;padding:16px;background:var(--card)}
.div24{font:11px 'IBM Plex Mono',monospace;color:var(--muted)}
.div25{font-weight:700;margin-top:2px}
.p2{margin:6px 0 0;color:var(--muted)}
.section3{padding:56px 0 64px;scroll-margin-top:90px}
.div26{font-size:14.5px;color:var(--muted);margin-top:4px}
.div27{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:14px;margin-top:16px}
.div28{border:1px solid var(--line);border-radius:12px;padding:20px 22px;background:var(--card)}
.div29{font:12px 'IBM Plex Mono',monospace;color:var(--muted)}
.div30{display:flex;flex-direction:column;gap:6px;margin-top:10px;font-size:15.5px;line-height:1.65}
/* Bulleted so the two platform columns read as lists rather than one run of text.
   The marker is drawn rather than a list-item, because the hover highlight below
   spans the full row and a real bullet would sit outside it. */
.div31{padding:6px 8px 6px 22px;margin:0 -8px;transition:background .2s;position:relative}
.div31::before{content:"";position:absolute;left:9px;top:.72em;width:4px;height:4px;border-radius:50%;background:var(--muted)}
.div31[data-pair="1"]::before{background:var(--accent)}
.div32{margin-top:48px;border:1px solid var(--line);border-radius:12px;padding:20px 24px;display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;background:var(--card)}
.div33{font-size:18px;font-weight:700;margin-top:2px}
.a4{background:var(--ink);color:var(--bg);padding:10px 18px;border-radius:8px;font-size:14px;font-weight:600;text-decoration:none}
.a4:hover{background:var(--accent);color:var(--accent-ink)}
.aside1{position:relative}
.div34{position:sticky;top:96px;padding:56px 0 0 20px;font:12.5px/1.35 'IBM Plex Mono',monospace}
.div35{position:absolute;left:-1px;top:56px;bottom:0;width:2px;background:var(--accent);transform-origin:top;transform:scaleY(var(--rail-scale,0));transition:transform .15s linear}
.nav1{display:flex;flex-direction:column;gap:16px}
.a5{color:var(--muted);text-decoration:none;transition:color .2s}

/* The rail is a fixed 150px column, so a phone was left ~160px of body width.
   Below this width the page goes single-column and the section index becomes a
   compact translucent pill floating over the content: numbers only, with the
   section name kept as each link's aria-label so the accessible name survives. */
@media (max-width: 820px){
  .div4{grid-template-columns:minmax(0,1fr);padding:0 20px}
  .main1{padding-right:0;border-right:0}
  /* Down the right edge, vertically centred — a thumb reaches it without covering
     the content the way a bottom bar does. */
  .aside1{position:fixed;right:10px;top:50%;transform:translateY(-50%);z-index:30}
  .div34{position:static;padding:8px 6px;border:1px solid var(--line);border-radius:999px;
    background:var(--card);background:color-mix(in srgb,var(--card) 78%,transparent);
    -webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px)}
  .div35{display:none}
  .nav1{flex-direction:column;gap:2px}
  .a5{min-width:30px;padding:5px 0;text-align:center;font-size:11px}
  .b1{display:none}
}
.a5:hover{color:var(--ink);text-decoration:none}
.div36{position:fixed;inset:0;z-index:50;background:rgba(10,12,16,.86);display:flex;align-items:center;justify-content:center;padding:32px;cursor:zoom-out;animation:rise .2s ease both}
.img2{max-width:100%;max-height:100%;border-radius:22px;box-shadow:0 30px 80px rgba(0,0,0,.5)}
</style>
