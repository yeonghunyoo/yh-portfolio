/* The pipeline reads left-to-right with → between the steps. On a phone the cards
   wrap onto their own lines and the arrows are left stranded mid-row, pointing at
   nothing. Below this width it becomes one column and the same glyph is turned to
   point down the flow. Only the arrows inside the pipeline are rotated — .span9 is
   also a caption class elsewhere on this screen. */
@media (max-width:820px){
  .div22{flex-direction:column;align-items:stretch;flex-wrap:nowrap;gap:0}
  /* `flex:none` alone — a column flex child already stretches to the full content
     width. Adding width:100% would put the cards' padding and border *outside* that
     width (there is no global box-sizing:border-box here) and push them past the
     panel they sit in. */
  .div22>.div23,.div22>.div26,.div22>.div27,.div22>.div29{flex:none}
  .div22>.div28{flex:none;flex-direction:row;flex-wrap:wrap;justify-content:center;gap:6px;padding:0}
  .div22>.span9{align-self:center;transform:rotate(90deg);margin:8px 0;line-height:1}
}

@media (max-width:820px) and (prefers-reduced-motion:no-preference){
  /* The staggered reveal is per-card; in one column it should still read top-down. */
  .div22>*{animation-duration:.4s}
}
