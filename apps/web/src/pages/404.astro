---
/**
 * Transplanted from the 404 view of the design export the human added after the
 * contract was frozen. The three destination cards are built from `SCREEN_ORDER`, so
 * a screen added to the contract shows up here without this file being touched.
 */
import { Screens, ScreenPaths } from "@generated/Screens";
import Base from "../layouts/Base.astro";
import SystemChrome from "../components/SystemChrome.astro";
import { SCREEN_ORDER } from "../lib/meta";
import { ContactCopy, NotFoundCopy } from "../content/systemCopy";

const cards = SCREEN_ORDER.map((id) => ({
  path: ScreenPaths[id],
  ...NotFoundCopy.cards[id],
}));
---

<Base screen={Screens.resume} title={`404 — ${NotFoundCopy.headline}`} description={NotFoundCopy.body}>
  <SystemChrome>
    <main class="page">
      <div class="status">{NotFoundCopy.status}</div>
      <h1 class="code">4<span>0</span>4</h1>
      <p class="headline">{NotFoundCopy.headline}</p>
      <p class="body">{NotFoundCopy.body}</p>

      <div class="cards">
        {
          cards.map((card) => (
            <a class="card" href={card.path}>
              <div class="route">{card.path}</div>
              <div class="name">{card.name}</div>
              <div class="blurb">{card.blurb}</div>
            </a>
          ))
        }
      </div>

      <div class="contact">
        {NotFoundCopy.contactLabel}<a href={`mailto:${ContactCopy.email}`}>{ContactCopy.email}</a>
      </div>
    </main>
  </SystemChrome>
</Base>

<script>
  import { initSystemPage } from "../lib/systemPage";
  initSystemPage();
</script>

<style>
  .page{max-width:1080px;margin:0 auto;padding:96px 32px}
  .status{font:13px 'IBM Plex Mono',monospace;color:var(--muted)}
  .code{margin:10px 0 0;font:700 clamp(72px,14vw,140px)/1 'IBM Plex Mono',monospace;letter-spacing:-.04em;color:var(--ink)}
  .code span{color:var(--accent)}
  .headline{margin:28px 0 0;font-size:22px;line-height:1.5;font-weight:600;max-width:640px;text-wrap:pretty}
  .body{margin:10px 0 0;font-size:17px;line-height:1.75;color:var(--muted);max-width:640px;text-wrap:pretty}
  .cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px;margin-top:36px;max-width:820px}
  .card{border:1px solid var(--line);border-radius:12px;padding:18px 20px;background:var(--card);color:var(--ink);text-decoration:none;transition:border-color .2s,transform .2s}
  .card:hover{border-color:var(--accent);transform:translateY(-3px)}
  .route{font:11px 'IBM Plex Mono',monospace;color:var(--muted)}
  .name{font-weight:700;font-size:16px;margin-top:4px}
  .blurb{font-size:14px;color:var(--muted);margin-top:2px}
  .contact{margin-top:40px;font:13px 'IBM Plex Mono',monospace;color:var(--muted)}

  @media (max-width:820px){
    .page{padding:64px 20px 96px}
    .cards{grid-template-columns:minmax(0,1fr)}
  }
</style>
