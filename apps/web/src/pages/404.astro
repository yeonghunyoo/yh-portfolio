---
import { Screens, ScreenPaths } from "@generated/Screens";
import { header } from "../content/header";
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { PAGE_TITLE } from "../lib/screens";

/**
 * The design has no error screen, so this page invents no copy: the status code and
 * the header's own wordmark link back to the document. A Strings key for the message
 * is listed in the report for the human.
 */
const STATUS = "404";
---

<Base title={`${STATUS} — ${PAGE_TITLE}`}>
  <SiteHeader />

  <main class="page">
    <p class="status">{STATUS}</p>
    <a class="back" href={ScreenPaths[Screens.s0]}>{header.wordmark}</a>
  </main>
</Base>

<style>
  .page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 96px 32px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .status {
    margin: 0;
    font: 700 34px/1.3 var(--font-mono);
    color: var(--muted);
  }

  .back {
    font-weight: 700;
    font-size: 16px;
    color: var(--ink);
    text-decoration: none;
  }

  .back:hover {
    color: var(--accent);
  }
</style>
