---
/**
 * The design has no error screen, so this page invents no copy: it shows the status
 * code and the resume's own wordmark as the way back. A Strings key for a 404 message
 * is listed in the build report for the human.
 */
import { Screens, ScreenPaths } from "@generated/Screens";
import { Strings } from "@generated/Strings";
import Base from "../layouts/Base.astro";
import { SCREEN_META } from "../lib/meta";

const STATUS = "404";
---

<Base screen={Screens.resume} title={`${STATUS} — ${SCREEN_META[Screens.resume].title}`}>
  <main class="page">
    <p class="status">{STATUS}</p>
    <a class="back" href={ScreenPaths[Screens.resume]}>{Strings.Resume.yuyeonghun}</a>
  </main>
</Base>

<script>
  import { initTheme } from "../lib/theme";
  initTheme();
</script>

<style>
  .page {
    max-width: 1080px;
    margin: 0 auto;
    padding: 96px 32px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .status {
    margin: 0;
    font: 700 34px/1.3 "IBM Plex Mono", monospace;
    color: var(--muted);
  }

  .back {
    font-weight: 700;
    font-size: 16px;
    color: var(--ink);
    text-decoration: none;
  }

  .back:hover {
    color: var(--accent);
  }
</style>
