---
import { Screens } from "@generated/Screens";
import { OPENAPI_DRAFT, assertCodeSamplesMatchStrings } from "../lib/codeBlocks";
import { backendSpec } from "../content/s4";

assertCodeSamplesMatchStrings();

const { approach, interview, apiSpec, result } = backendSpec;
---

<section id={Screens.s4} class="section">
  <div class="case">
    <div class="kicker">{backendSpec.kicker}</div>
    <h2 class="title">{backendSpec.title}</h2>

    <div class="body">
      <div class="label">{backendSpec.labels.problem}</div>
      <div>{backendSpec.problem}</div>

      <div class="label">{backendSpec.labels.approach}</div>
      <div>
        {approach.lead} <b>{approach.emphasis}</b>{approach.tail}
      </div>

      <div class="label">{backendSpec.labels.implementation}</div>
      <div>
        <div class="step">{interview.title}</div>
        <div class="interview">
          {
            interview.steps.map((step) => (
              <div class="interviewCard">
                <b>{step.name}</b>
                <br />
                <span class="interviewNote">{step.note}</span>
              </div>
            ))
          }
        </div>

        <div class="step stepSpaced">{apiSpec.title}</div>
        <div class="apiNote">
          {apiSpec.note.lead} <b>{apiSpec.note.emphasis}</b>{apiSpec.note.middle} <code>{apiSpec.note.file}</code> {apiSpec.note.tail}
        </div>
        <div class="codeCard"><pre tabindex="0">{OPENAPI_DRAFT}</pre></div>
      </div>

      <div class="label">{backendSpec.labels.result}</div>
      <div>
        {result.lead}
        <div class="panel">
          <div class="panelHead">
            {result.scale.label} <b class="strong">{result.scale.emphasis}</b> {result.scale.tail}
          </div>

          <div class="tableScroll" tabindex="0">
            <table class="comboTable">
              <thead>
                <tr>
                  <th>{result.headers.id}</th>
                  <th>{result.headers.db}</th>
                  <th>{result.headers.auth}</th>
                  <th>{result.headers.hosting}</th>
                  <th>{result.headers.cost}</th>
                  <th>{result.headers.checkedOn}</th>
                  <th>{result.headers.lockIn}</th>
                </tr>
              </thead>
              <tbody>
                {
                  result.combos.map((row) => (
                    <tr>
                      <td class="comboId">{row.id}</td>
                      <td>{row.db}</td>
                      <td>{row.auth}</td>
                      <td>{row.hosting}</td>
                      <td>
                        <b>{row.cost}</b>
                      </td>
                      <td>{row.checkedOn}</td>
                      <td>{row.lockIn}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>

        <ul class="notes">
          <li>{result.notes.summary}</li>
          <li>
            {result.notes.report.lead} <b class="strong">{result.notes.report.emphasis}</b>{result.notes.report.tail}
          </li>
          <li>{result.notes.why}</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .section {
    padding: 56px 0 0;
    scroll-margin-top: 90px;
  }

  .case {
    border-top: 1px solid var(--line);
    padding-top: 36px;
  }

  .kicker {
    font: 12px var(--font-mono);
    color: var(--muted);
  }

  .title {
    margin: 6px 0 0;
    font-size: 28px;
    line-height: 1.3;
    font-weight: 700;
  }

  .body {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 16px 22px;
    margin-top: 24px;
    font-size: 17px;
    line-height: 1.75;
  }

  .label {
    font: 12px var(--font-mono);
    color: var(--muted);
    padding-top: 5px;
  }

  .step {
    font-weight: 700;
  }

  .stepSpaced {
    margin-top: 22px;
  }

  .interview {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 8px;
    margin-top: 10px;
  }

  .interviewCard {
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 12px 14px;
    background: var(--card);
    font-size: 15px;
    line-height: 1.55;
  }

  .interviewNote {
    color: var(--muted);
  }

  .apiNote {
    font-size: 15.5px;
    margin-top: 4px;
  }

  .apiNote code {
    font: 12.5px var(--font-mono);
  }

  .codeCard {
    background: var(--code-bg);
    color: var(--code-ink);
    border-radius: 10px;
    padding: 14px 16px;
    margin-top: 10px;
    min-width: 0;
  }

  .panel {
    margin-top: 12px;
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    background: var(--card);
  }

  .panelHead {
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
    font-size: 14.5px;
    color: var(--muted);
  }

  .strong {
    color: var(--ink);
  }

  .tableScroll {
    overflow-x: auto;
  }

  .comboTable {
    min-width: 640px;
  }

  .comboId {
    font: 12.5px var(--font-mono);
  }

  .notes {
    margin: 14px 0 0;
    padding-left: 18px;
    font-size: 15.5px;
    color: var(--muted);
  }
</style>
