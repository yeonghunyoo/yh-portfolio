---
import { Screens } from "@generated/Screens";
import { SECRET_NUDGE, assertCodeSamplesMatchStrings } from "../lib/codeBlocks";
import { secretIsolation } from "../content/s5";

assertCodeSamplesMatchStrings();

const { implementation, result, cta } = secretIsolation;
---

<section id={Screens.s5} class="section">
  <div class="case">
    <div class="kicker">{secretIsolation.kicker}</div>
    <h2 class="title">{secretIsolation.title}</h2>

    <div class="body">
      <div class="label">{secretIsolation.labels.problem}</div>
      <div>{secretIsolation.problem}</div>

      <div class="label">{secretIsolation.labels.implementation}</div>
      <div>
        {implementation.lead} <b>{implementation.envOnly}</b> {implementation.middle} <b>{implementation.hook}</b>{implementation.fullStop}
      </div>

      <div class="label">{secretIsolation.labels.result}</div>
      <div>
        {result.lead} <b>{result.count}</b> {result.tail}
        <div class="codeCard">
          <div class="codeTitle">{result.nudgeTitle}</div>
          <pre tabindex="0">{SECRET_NUDGE}</pre>
        </div>
      </div>
    </div>

    <div class="cta">
      <div>
        <div class="ctaKicker">{cta.kicker}</div>
        <div class="ctaTitle">{cta.title}</div>
      </div>
      <a class="ctaLink" href={cta.href}>{cta.action}</a>
    </div>
  </div>
</section>

<style>
  .section {
    padding: 56px 0 64px;
    scroll-margin-top: 90px;
  }

  .case {
    border-top: 1px solid var(--line);
    padding-top: 36px;
  }

  .kicker {
    font: 12px var(--font-mono);
    color: var(--muted);
  }

  .title {
    margin: 6px 0 0;
    font-size: 28px;
    line-height: 1.3;
    font-weight: 700;
  }

  .body {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 16px 22px;
    margin-top: 24px;
    font-size: 17px;
    line-height: 1.75;
  }

  .label {
    font: 12px var(--font-mono);
    color: var(--muted);
    padding-top: 5px;
  }

  .codeCard {
    background: var(--code-bg);
    color: var(--code-ink);
    border-radius: 10px;
    padding: 14px 16px;
    margin-top: 12px;
    min-width: 0;
  }

  .codeTitle {
    font: 600 12.5px var(--font-mono);
    color: var(--accent);
    margin-bottom: 10px;
  }

  .cta {
    margin-top: 48px;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 20px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    background: var(--card);
  }

  .ctaKicker {
    font: 12px var(--font-mono);
    color: var(--muted);
  }

  .ctaTitle {
    font-size: 18px;
    font-weight: 700;
    margin-top: 2px;
  }

  .ctaLink {
    background: var(--ink);
    color: var(--bg);
    padding: 10px 18px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }

  .ctaLink:hover {
    background: var(--accent);
    color: var(--accent-ink);
    text-decoration: none;
  }
</style>
