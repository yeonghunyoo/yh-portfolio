---
import { Screens } from "@generated/Screens";
import { composition } from "../content/s1";
---

<section id={Screens.s1} class="section">
  <h2 class="title">{composition.title}</h2>

  <div class="cards">
    <div class="card">
      {composition.mcpServer.lead} <b>{composition.mcpServer.emphasis}</b>{composition.mcpServer.tail}
    </div>
    <div class="card">
      {composition.generatedConstants.lead} <b>{composition.generatedConstants.emphasis}</b> {composition.generatedConstants.tail}
    </div>
    <div class="card">
      {composition.openapi.lead} <b>{composition.openapi.emphasis}</b> {composition.openapi.tail}
    </div>
    <div class="card">
      {composition.agents.lead} <b>{composition.agents.platformCount}</b> {composition.agents.designAgent} <b>{composition.agents.designAgentCount}</b>
    </div>
  </div>
</section>

<style>
  .section {
    padding: 40px 0 0;
    scroll-margin-top: 90px;
  }

  .title {
    margin: 0;
    font-size: 24px;
    font-weight: 700;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 10px;
    margin-top: 14px;
    font-size: 15.5px;
    line-height: 1.65;
  }

  .card {
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 14px 16px;
    background: var(--card);
  }
</style>
