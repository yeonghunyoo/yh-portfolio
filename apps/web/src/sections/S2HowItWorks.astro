---
import { Screens } from "@generated/Screens";
import { howItWorks } from "../content/s2";
---

<section id={Screens.s2} class="section">
  <h2 class="title">{howItWorks.title}</h2>

  <div class="steps">
    {
      howItWorks.steps.map((step) => {
        const Tag = step.href ? "a" : "div";
        return (
          <Tag
            class:list={["step", { link: !!step.href && !step.invert, invert: step.invert }]}
            href={step.href}
          >
            <div class="ordinal">{step.ordinal}</div>
            <div class="name">{step.name}</div>
            <div class="description">{step.description}</div>
          </Tag>
        );
      })
    }
  </div>
</section>

<style>
  .section {
    padding: 44px 0 0;
    scroll-margin-top: 90px;
  }

  .title {
    margin: 0;
    font-size: 24px;
    font-weight: 700;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 8px;
    margin-top: 14px;
  }

  .step {
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 12px;
    background: var(--card);
  }

  .link {
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.2s;
  }

  .link:hover {
    border-color: var(--accent);
    text-decoration: none;
  }

  .invert {
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--bg);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .invert:hover {
    opacity: 0.85;
    text-decoration: none;
  }

  .ordinal {
    font: 11px var(--font-mono);
    color: var(--muted);
  }

  .invert .ordinal {
    color: inherit;
    opacity: 0.7;
  }

  .name {
    font-weight: 700;
    font-size: 14px;
    margin-top: 2px;
  }

  .description {
    font-size: 13.5px;
    color: var(--muted);
    margin-top: 3px;
    line-height: 1.5;
  }

  .invert .description {
    color: inherit;
    opacity: 0.8;
  }
</style>
