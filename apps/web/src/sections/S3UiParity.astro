---
import { Image, getImage } from "astro:assets";
import { Screens } from "@generated/Screens";
import { Strings } from "@generated/Strings";
import CodeSample from "../components/CodeSample.astro";
import {
  GENERATED_STRINGS_KOTLIN,
  GENERATED_STRINGS_SWIFT,
  TRANSLATION_SAMPLES,
  assertCodeSamplesMatchStrings,
} from "../lib/codeBlocks";

import onboardingCompare from "@design-uploads/c1bc2403.png";
import homeCompare from "@design-uploads/ec8ec00e.png";
import soundCompare from "@design-uploads/cf133459.png";
import statsCompare from "@design-uploads/278ec644.png";
import extraCompare from "@design-uploads/c66951c6.png";

// Fails the build if the code samples ever drift from shared/generated/Strings.ts.
assertCodeSamplesMatchStrings();

// Before/after numbers of the refinement, as `label → value` rows.
const refinementRows = [
  { label: Strings.Shared._917JulHanPail, value: Strings.Shared.hwamyeondangTeuri4Gae321243 },
  { label: Strings.Shared.saekRiteoreol119Gae, value: Strings.Shared._0Gae },
  {
    label: Strings.Shared.ireumEoldeonMunguAikonDongjak,
    value: Strings.Shared.mungu80Aikon10Haendeulreo25,
  },
  { label: Strings.Shared.peurototaipJangsik, value: Strings.Shared.jeondalAnHam },
];

// The five comparison shots. `alt` is a plain attribute in the prototype and has no
// Strings key in the contract — kept verbatim.
const comparisons = [
  {
    image: onboardingCompare,
    alt: "온보딩 화면 비교",
    caption: Strings.Shared.onbodingBeoteunWichiYeobaekiAEseo,
  },
  {
    image: homeCompare,
    alt: "홈 화면 비교",
    caption: Strings.Shared.homHadanChucheonMiksingBaechiwaImiji,
  },
  {
    image: soundCompare,
    alt: "사운드 화면 비교",
    caption: Strings.Shared.saundeuTaimeoDeuropdaunSiUiKkaejim,
  },
  {
    image: statsCompare,
    alt: "기록 화면 비교",
    caption: Strings.Shared.girokHadanSafeAreaMitJeongryeoliUidowa,
  },
  {
    image: extraCompare,
    alt: "추가 비교",
    caption: Strings.Shared.geuOeBeoteunTeochiyeongyeokBateomsiteuHaendeul,
  },
];

/** Full-size variant behind the lightbox — optimised, not the 1.2 MB source PNG. */
const comparisonsWithZoom = await Promise.all(
  comparisons.map(async (comparison) => ({
    ...comparison,
    zoom: await getImage({
      src: comparison.image,
      width: Math.min(comparison.image.width, 1800),
      format: "webp",
    }),
  })),
);

const [htmlSample, treeSample, swiftSample, composeSample] = TRANSLATION_SAMPLES;
---

<section id={Screens.s3} class="section" data-tok-root>
  <div class="case">
    <div class="kicker">{Strings.Shared.keiseuSeuteodi1}</div>
    <h2 class="title">{Strings.Shared.uIuxGuhyeonJeonghapseongeulWihanGyuchik}</h2>

    <div class="body">
      <div class="label">{Strings.Shared.munje}</div>
      <div>
        {Strings.Shared.claudeDesignINaebonaeneunHtmlEun}
        <ul class="bullets">
          <li>{Strings.Shared.hwamyeon5Gaega917JulPail}</li>
          <li>{Strings.Shared.seosikiJeonbuInrainStyle166Gae}</li>
          <li>{Strings.Shared.aepeEolneunPeurototaipJangsikiSeokyeoIteum}</li>
        </ul>
      </div>

      <div class="label">{Strings.Shared.jeopgeun}</div>
      <div>
        {Strings.Shared.makeudaunGibanSanmunEuroIrueojinSoft} <b>{Strings.Shared.suchihwadoenMunseoSanchulmuleulKodeuGibanPaipeuraineuro}</b>{Strings.Shared.hagoIreulGibaneuroEijeonteugaJayulseongeulGajigo}
      </div>

      <div class="label">{Strings.Shared.guhyeon}</div>
      <div>
        <div class="step">{Strings.Shared._1ClaudeDesignUiHandoffPaekijireul}</div>
        <div class="stepNote">
          {Strings.Shared.gateunYosoGap20MunguSaek} <span class="tokenLegend">{Strings.Shared.jeomseonMitjul}</span> {Strings.Shared.bubuneMauseureulOlrimyeonNameojiKodeueseoGateun}
        </div>

        <div class="samples samplesFirst">
          {htmlSample && <CodeSample sample={htmlSample} />}
          {treeSample && <CodeSample sample={treeSample} />}
        </div>
        <div class="samples">
          {swiftSample && <CodeSample sample={swiftSample} />}
          {composeSample && <CodeSample sample={composeSample} />}
        </div>

        <div class="numbersTitle">{Strings.Shared.jeongjeJeonhuuiIpryeokeulSutjaroBomyeon}</div>
        <div class="numbers">
          {
            refinementRows.map((row) => (
              <div class="numberRow">
                <span class="numberLabel">{row.label}</span>
                <span class="numberValue">{row.value}</span>
              </div>
            ))
          }
        </div>

        <div class="step stepSecond">{Strings.Shared._2SeobeogaGongtongRisoseureulGakPeulraetpome}</div>
        <div class="generatedNote">
          <code>{Strings.Shared.sharedGenerated}</code> {Strings.Shared.eGateunNaeyongiSwiftKotlinEuro} <code>{Strings.Shared.apiRoutesScreensDesignTokensIcons}</code> {Strings.Shared.doDuEoneoroSaengseongdoepnida}
        </div>
        <div class="generatedCards">
          <div class="generatedCard">
            <div class="generatedTitle">{Strings.Shared.stringsSwift}</div>
            <pre class="generatedCode" tabindex="0">{GENERATED_STRINGS_SWIFT}</pre>
          </div>
          <div class="generatedCard">
            <div class="generatedTitle">{Strings.Shared.stringsKt}</div>
            <pre class="generatedCode" tabindex="0">{GENERATED_STRINGS_KOTLIN}</pre>
          </div>
        </div>
      </div>

      <div class="label">{Strings.Shared.gyeolgwa}</div>
      <div>
        {Strings.Shared.gateunHwamyeoneulMandeuneunDeEijeonteugaSseuneun}
        <div class="panel">
          <div class="panelHead">
            <span class="panelTitle">{Strings.Shared.seongneungGeomjeungHandoffPackageJeongjeJeonhu}</span>
            <span class="panelMeta">{Strings.Shared.homeStatsIosAndroid2Hoe}</span>
          </div>

          <table>
            <thead>
              <tr>
                <th></th>
                <th>{Strings.Shared.aWonbonHtml57Kb}</th>
                <th>{Strings.Shared.bJeongjehanReiautTeuri}</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="rowLabel">{Strings.Shared.tokeunPyeonggyun}</td>
                <td>{Strings.Shared._905K}</td>
                <td><b>{Strings.Shared._551K}</b> <span class="delta">{Strings.Shared._39}</span></td>
              </tr>
              <tr>
                <td class="rowLabel">{Strings.Shared.hwamyeonJeonghapseong}</td>
                <td>{Strings.Shared._8BeonJung7BeonHwamyeoneul}</td>
                <td>{Strings.Shared.ppatteurinGeonChuchulgigaTeurieAnDameun}</td>
              </tr>
            </tbody>
          </table>

          <div class="panelFoot">
            {Strings.Shared.gateunHwamyeoneulGateunModelroGuhyeonhageHago} <b class="strong">{Strings.Shared.ipryeokman}</b> {Strings.Shared.bakkwoBigyoDijainiHwakjeongdoenSanghwangeseonJeonghapseongi}
          </div>
        </div>

        <div class="compareTitle">
          {Strings.Shared.uIuxGuhyeonJeonghapseongBigyo} <span class="compareHint">{Strings.Shared.oenjjokbuteoBReiautTeuriAhtml}</span>
        </div>
        <div class="compareGrid">
          {
            comparisonsWithZoom.map((comparison) => (
              <figure class="figure">
                <button
                  type="button"
                  class="zoom"
                  data-lightbox-open
                  data-lightbox-src={comparison.zoom.src}
                  data-lightbox-alt={comparison.alt}
                >
                  <Image src={comparison.image} alt={comparison.alt} width={720} format="webp" />
                </button>
                <figcaption class="caption">{comparison.caption}</figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initTokenHighlight } from "../lib/tokenHighlight";

  initTokenHighlight();
</script>

<style>
  .section {
    padding: 56px 0 0;
    scroll-margin-top: 90px;
  }

  .case {
    border-top: 1px solid var(--line);
    padding-top: 36px;
  }

  .kicker {
    font: 12px var(--font-mono);
    color: var(--muted);
  }

  .title {
    margin: 6px 0 0;
    font-size: 28px;
    line-height: 1.3;
    font-weight: 700;
  }

  .body {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 16px 22px;
    margin-top: 24px;
    font-size: 17px;
    line-height: 1.75;
  }

  .label {
    font: 12px var(--font-mono);
    color: var(--muted);
    padding-top: 5px;
  }

  .bullets {
    margin: 8px 0 0;
    padding-left: 18px;
    color: var(--muted);
    font-size: 14.5px;
  }

  .step {
    font-weight: 700;
  }

  .stepSecond {
    margin-top: 26px;
  }

  .stepNote {
    font-size: 14px;
    color: var(--muted);
    margin-top: 4px;
  }

  .tokenLegend {
    border-bottom: 1px dashed var(--accent);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 12.5px;
  }

  .samples {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 10px;
    margin-top: 10px;
  }

  .samplesFirst {
    margin-top: 12px;
  }

  .numbersTitle {
    margin-top: 18px;
    font-weight: 600;
  }

  .numbers {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 8px 24px;
    margin-top: 8px;
    font-size: 15.5px;
  }

  .numberRow {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    border-bottom: 1px solid var(--line-soft);
    padding: 6px 0;
  }

  .numberLabel {
    color: var(--muted);
  }

  .numberValue {
    font-weight: 600;
  }

  .generatedNote {
    font-size: 15px;
    color: var(--muted);
    margin-top: 4px;
  }

  .generatedNote code {
    font: 12.5px var(--font-mono);
  }

  .generatedCards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 10px;
    margin-top: 10px;
  }

  .generatedCard {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 12px 14px;
    min-width: 0;
  }

  .generatedTitle {
    font: 600 12.5px var(--font-mono);
    color: var(--accent);
    margin-bottom: 8px;
  }

  .generatedCode {
    color: var(--ink);
  }

  .panel {
    margin-top: 14px;
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    background: var(--card);
  }

  .panelHead {
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }

  .panelTitle {
    font-weight: 700;
  }

  .panelMeta {
    font: 12px var(--font-mono);
    color: var(--muted);
  }

  .rowLabel {
    color: var(--muted);
  }

  .delta {
    color: var(--accent);
    font-weight: 600;
  }

  .panelFoot {
    padding: 12px 16px;
    font-size: 15px;
    color: var(--muted);
  }

  .strong {
    color: var(--ink);
  }

  .compareTitle {
    margin-top: 22px;
    font-weight: 600;
  }

  .compareHint {
    font: 12px var(--font-mono);
    color: var(--muted);
    font-weight: 400;
    margin-left: 6px;
  }

  .compareGrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 12px;
    margin-top: 10px;
  }

  .figure {
    margin: 0;
  }

  .zoom {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .zoom img {
    width: 100%;
    height: auto;
    border-radius: 10px;
    border: 1px solid var(--line);
    display: block;
    transition: transform 0.25s;
  }

  .zoom:hover img {
    transform: scale(1.015);
  }

  .caption {
    font-size: 14px;
    color: var(--muted);
    margin-top: 6px;
  }
</style>
