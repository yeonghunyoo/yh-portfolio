# @yh/web — copy to .env and fill in. NEVER commit the filled file.
# Only PUBLIC_* values reach the browser; never put a secret behind that prefix.

# Absolute site origin, used for canonical + Open Graph URLs.
# e.g. https://yeonghunyoo.dev — leave empty locally, the page falls back to the request origin.
PUBLIC_SITE_URL=

# Base URL of the views API. Empty = same origin (the Astro endpoints under /api),
# which is the deployed setup. Set it only when the API is served from another origin.
PUBLIC_API_BASE_URL=

# --- views API (the Astro endpoints under /api, handlers from @yh/backend) ---
# Server-side only: these must NEVER carry the PUBLIC_ prefix, or they would ship
# to the browser. Set them in the deployment environment (Vercel project settings).
# Both are required in production; when either is missing every /api/views route
# answers 503 store_unavailable, by contract.

# Upstash Redis REST endpoint, e.g. https://your-db-name.upstash.io
VIEWS_STORE_URL=

# Upstash Redis REST token (bearer, read+write). Rotate from the Upstash console.
VIEWS_STORE_TOKEN=

# Optional, local dev only: "memory" runs the counters in process, no credentials.
# Leave unset in every deployed environment.
# VIEWS_STORE_DRIVER=memory
